# LLM Gateway Configuration
# Copy this file to .env and fill in your values

# ============================================
# Required API Keys
# ============================================

# Gateway authentication
GATEWAY_API_KEY=your-gateway-api-key-here

# Provider API keys (at least one required)
GROQ_API_KEY=your-groq-api-key
OLLAMA_API_KEY=your-ollama-api-key
KILO_API_KEY=your-kilo-api-key
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
OPENCODE_ZEN_API_KEY=your-opencode-zen-api-key
ZAI_API_KEY=your-zai-api-key
COHERE_API_KEY=your-cohere-api-key
NOUS_API_KEY=your-nous-portal-api-key
OCI_API_KEY=your-oci-api-key
BAI_API_KEY=your-bai-api-key
INFERX_API_KEY=your-inferx-api-key
GMI_API_KEY=your-gmi-api-key
ORCAROUTER_API_KEY=your-orcarouter-api-key
AI_GATEWAY_API_KEY=your-ai-gateway-api-key
EMPERO_API_KEY=free

# ============================================
# Server Configuration
# ============================================

# Server port (default: 8080)
PORT=8080

# Metrics port for Prometheus scraping (default: 9090)
# This port should NOT be exposed to the internet.
# In Docker, bind to 127.0.0.1 only: 127.0.0.1:9090:9090
METRICS_PORT=9090

# Enable Go pprof inside the container at http://127.0.0.1:6060/debug/pprof/
# (default: false). Access it with docker exec; the port is not published.
PPROF_ENABLED=false

# Go runtime and container resource guardrails
GOMEMLIMIT=3GiB
GATEWAY_MEMORY_LIMIT=4g
GATEWAY_CPUS=1.5
GATEWAY_PIDS_LIMIT=512

# Maximum provider attempts in one request. Client hints can only lower this.
RETRY_MAX_ATTEMPTS=3

# Environment (development/production)
ENV=production

# Log level (debug/info/warn/error)
LOG_LEVEL=info

# ============================================
# Redis Configuration
# ============================================

# Redis URL (default: redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# Redis key prefix (default: llm_gateway)
REDIS_KEY_PREFIX=llm_gateway

# ============================================
# Rate Limiting
# ============================================

# Requests per IP per window (default: 100)
RATE_LIMIT_PER_IP=100

# Rate limit window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# ============================================
# CORS Configuration
# ============================================

# Allowed CORS origins (comma-separated, empty = allow all)
# Example: CORS_ORIGINS=https://example.com,https://app.example.com
CORS_ORIGINS=

# ============================================
# Docker Compose Settings
# ============================================

# External port mapping (default: 8080)
EXTERNAL_PORT=8080
OPENROUTER_API_KEY=your-openrouter-api-key
